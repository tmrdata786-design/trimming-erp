# Manager.io API
MANAGER_API_URL=http://promoerp.promoerp.it/api2
MANAGER_API_KEY=your-manager-io-api-key-here

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/trimming_erp

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=8h

# Frontend
FRONTEND_URL=https://yourusername.github.io/trimming-erp

# Allowed businesses (comma-separated)
ALLOWED_BUSINESSES=KEEL,TEST

# Server
PORT=3001
NODE_ENV=development

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100